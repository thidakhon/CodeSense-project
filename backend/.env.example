# Copy this file to .env for local development.
# On Render, add these as Environment Variables in the dashboard (never commit real keys).

# ===== Server =====
PORT=3002
# Local dev: http://localhost:5173
# Render: your frontend service URL, or * for simple cross-origin setups
CLIENT_ORIGIN=http://localhost:5173

# ===== Auth =====
# Generate a long random string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# ===== AI provider: OpenRouter (free models available, no payment required) =====
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=CodeSense

# Alternative: use OpenAI instead (requires credits)
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini

# Multiple keys can be comma-separated for rotation:
# OPENAI_API_KEYS=key1,key2
# OPENROUTER_API_KEYS=key1,key2

# ===== Behavior =====
USE_MOCK=false
USE_FALLBACK_ON_ERROR=true
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BASE_MS=3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# ===== Optional: Google sign-in =====
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
