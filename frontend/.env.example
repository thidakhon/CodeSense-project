# Copy this file to .env for local development.
# On Render, set these as Environment Variables on the Static Site.

# Backend API URL.
# Local dev: http://localhost:3002
# Render: https://your-backend-service.onrender.com
# Leave empty for same-origin hosting: VITE_API_URL=
VITE_API_URL=http://localhost:3002

# Optional: enable the "Continue with Google" button.
# Must match GOOGLE_CLIENT_ID on the backend.
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
